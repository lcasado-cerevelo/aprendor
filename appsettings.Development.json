{
  // Solo para desarrollo local (ASPNETCORE_ENVIRONMENT=Development). Estos valores de
  // ejemplo NO sirven fuera de Development: el arranque los rechaza.
  "Jwt": {
    "Key": "CHANGE-ME-to-a-long-random-secret-at-least-32-bytes!!"
  },
  "Bootstrap": {
    "AdminEmail": "admin@local",
    "AdminPassword": "ChangeMe123!"
  },
  // Claves de PRUEBA públicas de Cloudflare: el widget siempre pasa y siteverify acepta su
  // token de prueba. No sirven en producción. ExemptNetworks: en local, lo que llega sin
  // token directo desde esta máquina (el index.html de https://localhost:52044 mientras no
  // tenga el widget, los seeds) entra sin Turnstile; con token se valida igual, y con
  // X-Forwarded-For (pruebas de IP simuladas) se exige.
  "Turnstile": {
    "Enabled": true,
    "SiteKey": "1x00000000000000000000AA",
    "SecretKey": "1x0000000000000000000000000000000AA",
    "ExemptNetworks": [ "127.0.0.1/32", "::1/128" ]
  }
}
