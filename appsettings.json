{
  "ConnectionStrings": {
    "Catalog": "Server=localhost;Database=TP_Catalog;Trusted_Connection=True;TrustServerCertificate=True;",
    "DesignTenant": "Server=localhost;Database=TP_DesignTemplate;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "TrainingPlatform",
    "Audience": "TrainingPlatform",
    // Vacía a propósito: es un secreto. En el servidor va por variable de entorno
    // (APRENDOR_Jwt__Key) con al menos 32 bytes aleatorios; fuera de Development la
    // app no arranca si falta, si mide menos o si es la de ejemplo (CHANGE-ME).
    // La de desarrollo está en appsettings.Development.json.
    "Key": ""
  },
  // Admin de plataforma que se crea SOLO si el catálogo está vacío. Fuera de
  // Development no se crea sin contraseña ni con la de ejemplo: definir
  // APRENDOR_Bootstrap__AdminEmail y APRENDOR_Bootstrap__AdminPassword. Siempre nace
  // con cambio de contraseña obligatorio.
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Storage": {
    "UploadsPath": "App_Data/uploads"
  },
  // Subida de medios (/media): tamaño máximo por archivo en bytes (50 MB).
  "Media": {
    "MaxBytes": 52428800
  },
  // Alta de compañías: si hay plantilla (con {db}), el servidor arma la cadena de
  // conexión con el nombre de base validado (^[A-Za-z0-9_]{3,50}$, por defecto TP_<nombre>)
  // e ignora la que mande el cliente. Ej.: "Server=localhost;Database={db};Trusted_Connection=True;TrustServerCertificate=True;"
  "Tenants": {
    "ConnectionTemplate": ""
  },
  "Security": {
    // IPs de proxies (además de loopback) cuyo X-Forwarded-For / CF-Connecting-IP se
    // cree. Solo hace falta si cloudflared o el proxy corre en OTRA máquina.
    "TrustedProxies": [],
    // Con Cloudflare (túnel o proxy): "CF-Connecting-IP". Vacío = X-Forwarded-For.
    "ForwardedForHeader": "",
    // Tamaño máximo del cuerpo de una petición (1 MB) y el de los endpoints de contenido
    // del autor (ítems con imágenes embebidas, portada, logo y firma del certificado).
    "MaxRequestBytes": 1000000,
    "AuthoringMaxRequestBytes": 8388608
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    // Brevo (antes Sendinblue), vía su API HTTP (no SMTP): ApiKey es la única
    // credencial que hace falta. Ponla por variable de entorno en el servidor
    // (APRENDOR_Email__ApiKey), nunca en este archivo — es un secreto.
    "ApiKey": "",
    "From": "it@advancelogisticspr.com",
    "FromName": "Advance Logistics Support",
    "RemindersEnabled": "true",
    "DigestEnabled": "true",
    "DigestFrequency": "Weekly", // Daily | Weekly | Monthly
    "DigestHour": "8",
    "DigestDayOfWeek": "Monday", // solo aplica a Weekly
    "DigestDayOfMonth": "1" // solo aplica a Monthly
  },
  // URL pública (https) con la que se arman TODOS los enlaces de los correos
  // (restablecer contraseña, certificados, recordatorios). Fuera de Development es
  // obligatoria: la app no arranca sin ella (APRENDOR_App__BaseUrl). En desarrollo,
  // si está vacía, los enlaces salen del host de la petición.
  "App": { "BaseUrl": "" },
  // "*" en el archivo; en el servidor se fija con APRENDOR_AllowedHosts al dominio
  // público más localhost (p. ej. "aprendor.midominio.com;localhost"): así cualquier
  // otra cabecera Host recibe 400.
  "AllowedHosts": "*"
}
