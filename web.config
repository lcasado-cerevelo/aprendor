<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de IIS (el SDK la usa al publicar). Además del módulo de ASP.NET Core:
  - quita la cabecera Server (removeServerHeader, IIS 10+) y X-Powered-By;
  - limita el cuerpo de cualquier petición a 60 MB en IIS. La app aplica después sus
    propios límites: 1 MB por defecto y Media:MaxBytes (50 MB) en /media.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\TrainingPlatform.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="62914560" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
